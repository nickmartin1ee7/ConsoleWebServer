    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: ConsoleWebServer Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ConsoleWebServer/bin/Debug/net8.0/ConsoleWebServer.dll",
            "args": [ "-p", "8080", "-d", "${workspaceFolder}/wwwroot" ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        }

    ]
}